{
  "name": "picodev-lab",
  "displayName": "Picodev Lab",
  "description": "Plugs Copilot agent mode into Picodev Lab: a simulated Arduino bench in your browser, driven through the lab's MCP server. Compiles your sketch on your machine with arduino-cli.",
  "version": "0.7.1",
  "publisher": "picodev",
  "icon": "media/logo.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PICODEV-SAS/picodev-lab-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/PICODEV-SAS/picodev-lab-vscode/issues"
  },
  "homepage": "https://github.com/PICODEV-SAS/picodev-lab-vscode#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onMcpCollection:picodev-lab"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "picodev-lab",
        "label": "Picodev Lab"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "picodevLab",
          "title": "Picodev Lab",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "picodevLab": [
        {
          "type": "webview",
          "id": "picodevLab.view",
          "name": "Picodev Lab"
        }
      ]
    },
    "commands": [
      {
        "command": "picodevLab.open",
        "title": "%command.open%",
        "category": "Picodev Lab",
        "icon": "$(add)"
      },
      {
        "command": "picodevLab.challenge",
        "title": "%command.challenge%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.next",
        "title": "%command.next%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.push",
        "title": "%command.push%",
        "category": "Picodev Lab",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "picodevLab.visibility",
        "title": "%command.visibility%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.share",
        "title": "%command.share%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.openBench",
        "title": "%command.openBench%",
        "category": "Picodev Lab",
        "icon": "$(link-external)"
      },
      {
        "command": "picodevLab.panel",
        "title": "%command.panel%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.tellCopilot",
        "title": "%command.tellCopilot%",
        "category": "Picodev Lab",
        "icon": "$(sparkle)"
      },
      {
        "command": "picodevLab.brief",
        "title": "%command.brief%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.specWorkspace",
        "title": "%command.specWorkspace%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.meeting",
        "title": "%command.meeting%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.end",
        "title": "%command.end%",
        "category": "Picodev Lab"
      },
      {
        "command": "picodevLab.starter",
        "title": "%command.starter%",
        "category": "Picodev Lab"
      }
    ],
    "configuration": {
      "title": "Picodev Lab",
      "properties": {
        "picodevLab.autoPush": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoPush%"
        },
        "picodevLab.arduinoCli": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.arduinoCli%"
        },
        "picodevLab.agent": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "copilot"
          ],
          "enumDescriptions": [
            "%config.agent.auto%",
            "%config.agent.claude%",
            "%config.agent.copilot%"
          ],
          "default": "auto",
          "description": "%config.agent%"
        },
        "picodevLab.git": {
          "type": "boolean",
          "default": true,
          "description": "%config.git%"
        }
      }
    },
    "colors": [
      {
        "id": "picodevLab.statusBarForeground",
        "description": "%color.statusBarForeground%",
        "defaults": {
          "dark": "#E7746F",
          "light": "#C2504B",
          "highContrast": "#E7746F"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "picodevLab.next",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.push",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.visibility",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.share",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.openBench",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.panel",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.tellCopilot",
          "when": "picodevLab.session"
        },
        {
          "command": "picodevLab.end",
          "when": "picodevLab.session"
        }
      ],
      "editor/title": [
        {
          "command": "picodevLab.push",
          "when": "picodevLab.session && resourceExtname == .ino",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "picodevLab.openBench",
          "when": "view == picodevLab.view && picodevLab.session",
          "group": "navigation@1"
        },
        {
          "command": "picodevLab.tellCopilot",
          "when": "view == picodevLab.view && picodevLab.session",
          "group": "navigation@2"
        },
        {
          "command": "picodevLab.open",
          "when": "view == picodevLab.view && !picodevLab.session",
          "group": "navigation@1"
        },
        {
          "command": "picodevLab.end",
          "when": "view == picodevLab.view && picodevLab.session",
          "group": "session"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "picodevLab.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "folder",
            "title": "%walkthrough.folder.title%",
            "description": "%walkthrough.folder.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Picodev Lab"
            },
            "completionEvents": [
              "onCommand:picodevLab.starter",
              "onCommand:workbench.action.files.openFolder"
            ]
          },
          {
            "id": "session",
            "title": "%walkthrough.session.title%",
            "description": "%walkthrough.session.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Picodev Lab"
            },
            "completionEvents": [
              "onCommand:picodevLab.open",
              "onCommand:picodevLab.challenge"
            ]
          },
          {
            "id": "bench",
            "title": "%walkthrough.bench.title%",
            "description": "%walkthrough.bench.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Picodev Lab"
            },
            "completionEvents": [
              "onCommand:picodevLab.openBench"
            ]
          },
          {
            "id": "copilot",
            "title": "%walkthrough.copilot.title%",
            "description": "%walkthrough.copilot.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Picodev Lab"
            },
            "completionEvents": [
              "onCommand:picodevLab.tellCopilot"
            ]
          },
          {
            "id": "compile",
            "title": "%walkthrough.compile.title%",
            "description": "%walkthrough.compile.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Picodev Lab"
            },
            "completionEvents": [
              "onSettingChanged:picodevLab.arduinoCli",
              "onLink:https://arduino.github.io/arduino-cli/latest/installation/"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/run.js"
  },
  "dependencies": {
    "picodev-lab-client": "github:PICODEV-SAS/picodev-lab-client#v0.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "l10n": "./l10n",
  "vsce": {
    "dependencies": false
  }
}
